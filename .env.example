# Kafool — environment variables. Copy to .env.local and fill in real values.
# NEVER commit .env.local (it is gitignored). Values here must stay EMPTY.

# ── Supabase (required) ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Site (required) ───────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=

# ── Email — Resend (thank-you / recovery emails) ─────────────────────
RESEND_API_KEY=
EMAIL_FROM=

# ── SMS — Yemot Hamashiach ───────────────────────────────────────────
YEMOT_API_KEY=
SMS_API_KEY=
SMS_USERNAME=
SMS_SENDER=
LEADS_NOTIFY_PHONE=

# ── WhatsApp — Meta Cloud API (optional) ─────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_THANKS_TEMPLATE=
WHATSAPP_ABANDON_TEMPLATE=
NEXT_PUBLIC_WEBHOOK_KEY=

# ── Incoming payment webhook auth (optional) ─────────────────────────
WEBHOOK_SECRET=
CRON_SECRET=

# ── Kafool+ outgoing sync (optional) ─────────────────────────────────
KAFOOL_WEBHOOK_SECRET=

# ── Payment providers ────────────────────────────────────────────────
# Kesher
KESHER_BASE_URL=
KESHER_PAYMENT_BASE_URL=
KESHER_ENCRYPTION_KEY=
KESHER_WEBHOOK_SECRET=
# Grow (Meshulam)
GROW_API_KEY=
GROW_USER_ID=
GROW_PAGE_CODE=
GROW_ENV=
NEXT_PUBLIC_GROW_PAYMENT_LINK=

# ── AI (optional) ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# ── Dev only ──────────────────────────────────────────────────────────
KP_DEV_EMAIL=
